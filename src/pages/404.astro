---
import '../styles/base.css';
---

<!DOCTYPE html>
<html lang="nl-BE">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pagina niet gevonden - Gemeengoed</title>
<meta name="robots" content="noindex">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#F1ECDD" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#14170F" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preload" href="/fonts/lora-600.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/public-sans-400.woff2" as="font" type="font/woff2" crossorigin>
<style is:global>
  body {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 5vh, 3.5rem) 6vw;
    color: var(--ink-soft);
    font-size: 1.0625rem;
    text-align: center;
  }

  /* The missing plot is the illustration: one empty, dashed parcel. */
  main {
    position: relative;
    isolation: isolate;
    width: 100%;
    max-width: 36rem;
    padding: clamp(3rem, 12vw, 4.5rem) clamp(1.5rem, 6vw, 3rem);
  }

  .parcels {
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .parcels path.accent {
    stroke-dasharray: 4 4;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.2;
    margin: 0 0 1rem;
    color: var(--ink);
    text-wrap: balance;
  }

  p { margin: 0; }
</style>
</head>
<body>
  <main>
    <svg class="parcels" viewBox="0 0 400 200" preserveAspectRatio="none" aria-hidden="true">
      <path d="M6,14 L392,2 L398,186 L2,198 Z" class="accent" />
    </svg>
    <h1>Dit perceel bestaat niet.</h1>
    <p>Terug naar <a href="/">Gemeengoed</a>.</p>
  </main>
</body>
</html>
