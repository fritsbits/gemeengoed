---
import '../styles/base.css';

const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Gemeen Goed",
  "url": "https://gemeengoed.studio/",
  "logo": "https://gemeengoed.studio/apple-touch-icon.png",
  "description": "Gemeen Goed is de softwarestudio die organisaties met hetzelfde probleem samenbrengt en de software bouwt die ze samen dragen.",
  "founder": [
    {
      "@type": "Person",
      "name": "Frederik Vincx",
      "jobTitle": "Productontwerp & ontwikkeling",
      "image": "https://gemeengoed.studio/images/frederik.webp",
      "email": "frederik@gemeengoed.studio",
      "sameAs": ["https://www.linkedin.com/in/frederikvincx/", "https://frederikvincx.com/"]
    },
    {
      "@type": "Person",
      "name": "Anton Aerts",
      "jobTitle": "Organisaties & samenwerking",
      "image": "https://gemeengoed.studio/images/anton.webp",
      "email": "anton@gemeengoed.studio",
      "sameAs": "https://www.linkedin.com/in/antonaerts/"
    }
  ]
};
---

<!DOCTYPE html>
<html lang="nl-BE">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="generator" content={Astro.generator}>
<title>Gemeen Goed - software die we samen met een sector bouwen</title>
<meta name="description" content="Gemeen Goed is de softwarestudio die organisaties met hetzelfde probleem samenbrengt en de software bouwt die ze samen dragen.">
<link rel="canonical" href="https://gemeengoed.studio/">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#F1ECDD" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#14170F" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Gemeen Goed">
<meta property="og:locale" content="nl_BE">
<meta property="og:url" content="https://gemeengoed.studio/">
<meta property="og:title" content="Gemeen Goed - software die we samen met een sector bouwen">
<meta property="og:description" content="Gemeen Goed is de softwarestudio die organisaties met hetzelfde probleem samenbrengt en de software bouwt die ze samen dragen.">
<meta property="og:image" content="https://gemeengoed.studio/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Gemeen Goed, sociale softwarestudio. Software die we samen met een sector bouwen.">
<meta name="twitter:card" content="summary_large_image">
<link rel="preload" href="/fonts/lora-600.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/public-sans-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/lora-italic-500.woff2" as="font" type="font/woff2" crossorigin>
<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
<style is:global>
  body {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 5vh, 3.5rem) 6vw;
  }

  .wrap {
    width: 100%;
    max-width: 40rem;
  }

  .hero {
    padding: 1.5rem 0 0;
  }

  /* The parcel drawing belongs to the masthead only, so no line ever crosses body copy. */
  .masthead {
    position: relative;
    isolation: isolate;
    text-align: center;
  }

  .masthead .parcels {
    top: -2.5rem;
    left: clamp(-4.5rem, -5vw, -1rem);
    width: calc(100% + 2 * clamp(1rem, 5vw, 4.5rem));
    height: calc(100% + 4.5rem);
    -webkit-mask-image: linear-gradient(#000 40%, transparent);
    mask-image: linear-gradient(#000 40%, transparent);
  }

  .eyebrow {
    font-size: 0.8125rem;
    color: var(--ink-soft);
    letter-spacing: 0.01em;
    margin: 0 0 1rem;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.5rem, 8vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0 0 1rem;
    color: var(--ink);
  }

  .tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.1rem, 3vw, 1.35rem);
    line-height: 1.35;
    color: var(--moss);
    margin: 0;
    text-wrap: balance;
  }

  /* Same left edge as the names in the register below. */
  .intro {
    margin-top: 2rem;
    padding: 0 1.25rem;
    font-size: 1.0625rem;
    color: var(--ink-soft);
    -webkit-hyphens: none;
    hyphens: none;
  }

  /* The proposition is the paragraph to read first, so it alone gets full ink. */
  .intro p:nth-child(2) {
    color: var(--ink);
  }

  /* An outbound link should not outweigh the copy around it. The ochre underline still marks it. */
  .intro a {
    color: inherit;
  }

  .intro a:hover {
    color: var(--moss);
  }

  .intro p {
    margin: 0 0 1rem;
    text-wrap: pretty;
  }

  .intro p:last-child {
    margin-bottom: 0;
  }

  .invite {
    margin: 3rem 0 0;
    text-wrap: balance;
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 1.125rem;
    line-height: 1.35;
    color: var(--ink);
  }

  .register {
    margin-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .register-row {
    display: flex;
    border-bottom: 1px solid var(--line);
  }

  .plot {
    flex: 1 1 50%;
    padding: 1.25rem 1.25rem 0.9rem;
  }

  .plot + .plot {
    border-left: 1px solid var(--line);
  }

  .plot-head {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-bottom: 0.5rem;
  }

  .plot-photo {
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    object-fit: cover;
    background: var(--paper-alt);
    box-shadow: 0 0 0 1px var(--line);
  }

  .plot-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.35;
    margin: 0;
  }

  .plot-role {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--ink-soft);
  }

  /* The mail takes its own row, the secondary links share the row below it. */
  .plot-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 1.125rem;
  }

  .plot-links-mail {
    flex: 0 0 100%;
  }

  /* The padding makes the tap target, the list itself has no gap. */
  .plot-mail,
  .plot-secondary {
    display: inline-block;
    padding-block: 0.35rem;
  }

  /* Under keyboard focus the tap padding becomes margin, so the ring hugs the text
     like on every other link and nothing moves. */
  .plot-mail:focus-visible,
  .plot-secondary:focus-visible {
    padding-block: 0;
    margin-block: 0.35rem;
  }

  .plot-mail {
    font-size: 1rem;
    overflow-wrap: anywhere;
  }

  .plot-secondary {
    font-size: 0.875rem;
    color: var(--ink-soft);
    text-decoration-color: color-mix(in srgb, var(--ink-soft) 45%, transparent);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  footer {
    margin-top: 2rem;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--ink-soft);
    letter-spacing: 0.01em;
  }

  @media (max-width: 30rem) {
    .register-row {
      flex-direction: column;
    }
    .plot + .plot {
      border-left: none;
      border-top: 1px solid var(--line);
    }
    .plot-mail,
    .plot-secondary {
      padding-block: 0.6rem;
    }
    .plot-mail:focus-visible,
    .plot-secondary:focus-visible {
      padding-block: 0;
      margin-block: 0.6rem;
    }
    .plot {
      padding-bottom: 0.5rem;
    }
  }

  /* Only the narrowest phones may use the authored break in the long compound.
     Wider screens keep the word whole, so no paragraph ends on half a word by choice. */
  @media (max-width: 22rem) {
    .intro {
      -webkit-hyphens: manual;
      hyphens: manual;
    }
    /* Keeps the name clear of the parcel's side boundaries. */
    h1 {
      font-size: 2.25rem;
    }
  }

  @media print {
    body {
      display: block;
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The whole sheet arrives together, without a stagger. */
    .wrap {
      animation: rise 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
</head>
<body>
  <div class="wrap">
    <main>
    <div class="hero">
      <div class="masthead">
        <svg class="parcels" viewBox="0 0 800 224" preserveAspectRatio="none" aria-hidden="true">
          <path d="M-10,34 L66.1,31.3" />
          <path d="M66.1,31.3 L735.4,7.6" class="accent" />
          <path d="M735.4,7.6 L810,5" />
          <path d="M70,-6 L46,224" />
          <path d="M734,-6 L758,224" />
          <path d="M-10,118 L56.2,126" />
          <path d="M745.5,104 L810,97" />
        </svg>
        <p class="eyebrow">Sociale softwarestudio</p>
        <h1>Gemeen Goed</h1>
        <p class="tagline">Software die we samen met een sector bouwen.</p>
      </div>
      <div class="intro">
        <p>In de zachte sectoren betaalt elke organisatie apart voor hetzelfde wiel. De groten laten dure software op maat maken. De rest behelpt zich met pakketten die voor iemand anders gemaakt zijn, of haalt acrobatentoeren uit met Excel.</p>
        <p>Wij lossen dat op. We bouwen software samen met een sector, met organisaties die er qua software vaak buiten vallen maar wel goeie software verdienen. Zo helpen we ze de krachten bundelen: ze sturen mee via een gebruikersraad en betalen naar draagkracht. Wat we maken, blijven we onderhouden.</p>
        <p>Rond <a href="https://opvang.vlaanderen">Opvang.Vlaanderen</a> bracht Anton Aerts eerder 200 lokale besturen bijeen. Nu bouwen we een eerste dienst voor vrijwilligers&shy;coördinatoren.</p>
      </div>
    </div>

    <p class="invite">Werkt de software in jouw sector tegen? Mail een van ons.</p>

    <div class="register" role="group" aria-label="Contact">
      <div class="register-row">
        <div class="plot">
          <div class="plot-head">
            <img class="plot-photo" src="/images/frederik.webp" alt="" width="56" height="56" loading="lazy" decoding="async">
            <div>
              <h2 class="plot-name">Frederik Vincx</h2>
              <p class="plot-role">Productontwerp &amp; ontwikkeling</p>
            </div>
          </div>
          <ul class="plot-links">
            <li class="plot-links-mail"><a class="plot-mail" href="mailto:frederik@gemeengoed.studio">frederik@gemeengoed.studio</a></li>
            <li><a class="plot-secondary" href="https://www.linkedin.com/in/frederikvincx/" rel="noopener">LinkedIn<span class="visually-hidden"> van Frederik Vincx</span></a></li>
            <li><a class="plot-secondary" href="https://frederikvincx.com/" rel="noopener">Website<span class="visually-hidden"> van Frederik Vincx</span></a></li>
          </ul>
        </div>
        <div class="plot">
          <div class="plot-head">
            <img class="plot-photo" src="/images/anton.webp" alt="" width="56" height="56" loading="lazy" decoding="async">
            <div>
              <h2 class="plot-name">Anton Aerts</h2>
              <p class="plot-role">Organisaties &amp; samenwerking</p>
            </div>
          </div>
          <ul class="plot-links">
            <li class="plot-links-mail"><a class="plot-mail" href="mailto:anton@gemeengoed.studio">anton@gemeengoed.studio</a></li>
            <li><a class="plot-secondary" href="https://www.linkedin.com/in/antonaerts/" rel="noopener">LinkedIn<span class="visually-hidden"> van Anton Aerts</span></a></li>
          </ul>
        </div>
      </div>
    </div>

    </main>

    <footer>&copy; 2026 Gemeen Goed</footer>
  </div>
</body>
</html>
