<style is:global>
  body {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(2rem, 8vh, 5rem) 6vw clamp(1.5rem, 5vh, 3.5rem);
  }

  .wrap {
    width: 100%;
    max-width: 40rem;
  }

  .hero {
    padding: 1.5rem 0 0;
  }

  /* The parcel drawing belongs to the masthead only, so no line ever crosses body copy. */
  .masthead {
    position: relative;
    isolation: isolate;
    text-align: center;
  }

  .masthead .parcels {
    top: -2.5rem;
    left: clamp(-4.5rem, -5vw, -1rem);
    width: calc(100% + 2 * clamp(1rem, 5vw, 4.5rem));
    height: calc(100% + 4.5rem);
    -webkit-mask-image: linear-gradient(#000 40%, transparent);
    mask-image: linear-gradient(#000 40%, transparent);
  }

  .eyebrow {
    font-size: 0.8125rem;
    color: var(--ink-soft);
    letter-spacing: 0.01em;
    margin: 0 0 1rem;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.5rem, 8vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0 0 1rem;
    color: var(--ink);
  }

  .tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.1rem, 3vw, 1.35rem);
    line-height: 1.35;
    color: var(--moss);
    margin: 0;
    text-wrap: balance;
  }

  /* Each sentence of the tagline keeps its own line where the width allows it. */
  .tagline span {
    display: block;
  }

  /* Same left edge as the names in the register below. */
  .intro {
    margin-top: 2.5rem;
    padding: 0 1.25rem;
    font-size: 1.0625rem;
    color: var(--ink-soft);
  }

  .intro p {
    margin: 0 0 1rem;
    text-wrap: pretty;
  }

  /* The opening line is the one to read first, so it speaks in the display face. */
  .intro .lead {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.25rem, 3.4vw, 1.4375rem);
    line-height: 1.3;
    color: var(--ink);
    margin-bottom: 1.125rem;
    text-wrap: balance;
  }

  .intro .answer {
    color: var(--ink);
  }

  .intro .jump {
    margin: 1.5rem 0 0;
  }

  .section {
    margin-top: clamp(4rem, 10vh, 5.5rem);
  }

  .section-head {
    padding: 0 1.25rem;
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 4.4vw, 1.875rem);
    line-height: 1.15;
    letter-spacing: -0.005em;
    margin: 0 0 0.875rem;
    text-wrap: balance;
  }

  .section-head p {
    margin: 0 0 1rem;
    font-size: 1.0625rem;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .section-head p:last-child {
    margin-bottom: 0;
  }

  h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.3;
    margin: 0;
    text-wrap: balance;
  }

  /* Every list on the page is a register: hairlines above, between and below. */
  .register {
    margin-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .steps,
  .works {
    list-style: none;
    padding: 0;
    margin-bottom: 0;
  }

  .step,
  .work {
    display: grid;
    gap: 0 1rem;
    padding: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .step {
    grid-template-columns: 2.25rem minmax(0, 1fr);
  }

  /* The order is the message here, so the numerals are set large enough to read as one. */
  .step-n {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 1.75rem;
    line-height: 1;
    color: var(--ochre);
    padding-top: 0.05em;
  }

  .step p,
  .work p {
    margin: 0.375rem 0 0;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .work {
    grid-template-columns: 6.5rem minmax(0, 1fr);
  }

  .work-when {
    font-size: 0.8125rem;
    line-height: 1.6;
    letter-spacing: 0.01em;
    color: var(--ink-soft);
    padding-top: 0.2rem;
  }

  .work-when.now {
    color: var(--moss);
  }

  .work h3 {
    -webkit-hyphens: manual;
    hyphens: manual;
  }

  .work h3 a {
    text-decoration-color: color-mix(in srgb, var(--ochre) 70%, transparent);
  }

  .work .work-fact {
    color: var(--ink);
    font-size: 0.9375rem;
    margin-top: 0.625rem;
  }

  .work blockquote {
    margin: 1rem 0 0;
    padding: 0;
  }

  .work blockquote p {
    quotes: '\201C' '\201D';
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 1.1875rem;
    line-height: 1.35;
    color: var(--moss);
    margin: 0;
    text-wrap: balance;
  }

  .work blockquote p::before { content: open-quote; }
  .work blockquote p::after { content: close-quote; }

  .work blockquote footer {
    margin: 0.25rem 0 0;
    text-align: left;
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  .section-head .pair {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 1.125rem;
    line-height: 1.35;
    color: var(--moss);
  }

  .register-row {
    display: flex;
    border-bottom: 1px solid var(--line);
  }

  /* A column, so the mail and links sit on one line across both plots whatever the bio length. */
  .plot {
    flex: 1 1 50%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.25rem 0.9rem;
  }

  .plot + .plot {
    border-left: 1px solid var(--line);
  }

  .plot-head {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-bottom: 0.75rem;
  }

  .plot-photo {
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    object-fit: cover;
    background: var(--paper-alt);
    box-shadow: 0 0 0 1px var(--line);
  }

  .plot-name {
    font-size: 1.0625rem;
    line-height: 1.35;
  }

  .plot-role {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .plot-bio {
    margin: 0 0 0.75rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  /* The mail takes its own row, the secondary links share the row below it. */
  .plot-links {
    list-style: none;
    margin: auto 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 1.125rem;
  }

  .plot-links-mail {
    flex: 0 0 100%;
  }

  /* The padding makes the tap target, the list itself has no gap. */
  .plot-mail,
  .plot-secondary {
    display: inline-block;
    padding-block: 0.35rem;
  }

  /* Under keyboard focus the tap padding becomes margin, so the ring hugs the text
     like on every other link and nothing moves. */
  .plot-mail:focus-visible,
  .plot-secondary:focus-visible {
    padding-block: 0;
    margin-block: 0.35rem;
  }

  .plot-mail {
    font-size: 1rem;
    overflow-wrap: anywhere;
  }

  .plot-secondary {
    font-size: 0.875rem;
    color: var(--ink-soft);
    text-decoration-color: color-mix(in srgb, var(--ink-soft) 45%, transparent);
  }

  /* The page ends on the ask. It closes the sheet the way the masthead opens it:
     the same parcel, turned over, so the accent line runs underneath. */
  .invite {
    position: relative;
    isolation: isolate;
    margin-top: clamp(4.5rem, 11vh, 6.5rem);
    padding: 1rem 1.25rem 4.25rem;
    text-align: center;
    scroll-margin-top: 2rem;
  }

  .invite .parcels {
    bottom: -0.5rem;
    left: clamp(-4.5rem, -5vw, -1rem);
    width: calc(100% + 2 * clamp(1rem, 5vw, 4.5rem));
    height: calc(100% + 3rem);
    transform: scaleY(-1);
    -webkit-mask-image: linear-gradient(#000 35%, transparent 85%);
    mask-image: linear-gradient(#000 35%, transparent 85%);
  }

  .invite h2 {
    font-size: clamp(1.875rem, 6vw, 2.625rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin-bottom: 1.125rem;
  }

  .invite p {
    max-width: 31rem;
    margin: 0 auto;
    font-size: 1.125rem;
    color: var(--ink-soft);
    text-wrap: balance;
  }

  .cta {
    display: inline-block;
    margin-top: 1.75rem;
    padding: 0.8rem 1.75rem;
    border-radius: 999px;
    background: var(--moss);
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.3;
    text-decoration: none;
  }

  .cta:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .cta:active {
    transform: translateY(1px);
  }

  .invite .cta-address {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
    -webkit-user-select: all;
    user-select: all;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  body > .wrap > footer {
    margin-top: clamp(3.5rem, 9vh, 5rem);
    text-align: center;
    font-size: 0.8125rem;
    color: var(--ink-soft);
    letter-spacing: 0.01em;
  }

  @media (max-width: 30rem) {
    .register-row {
      flex-direction: column;
    }
    .plot + .plot {
      border-left: none;
      border-top: 1px solid var(--line);
    }
    .plot-mail,
    .plot-secondary {
      padding-block: 0.6rem;
    }
    .plot-mail:focus-visible,
    .plot-secondary:focus-visible {
      padding-block: 0;
      margin-block: 0.6rem;
    }
    .plot {
      padding-bottom: 0.5rem;
    }
    /* The date moves above the name instead of squeezing the text column. */
    .work {
      grid-template-columns: minmax(0, 1fr);
    }
    .work-when {
      padding-top: 0;
      margin-bottom: 0.125rem;
    }
  }

  @media (max-width: 22rem) {
    /* Keeps the name clear of the parcel's side boundaries. */
    h1 {
      font-size: 2.25rem;
    }
  }

  @media print {
    body {
      display: block;
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
    .cta {
      transition: background-color 0.15s ease-out, transform 0.1s ease-out;
    }
    /* The whole sheet arrives together, without a stagger. */
    .wrap {
      animation: rise 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
</head>
<body>
  <div class="wrap">
    <main>
    <div class="hero">
      <div class="masthead">
        <svg class="parcels" viewBox="0 0 800 224" preserveAspectRatio="none" aria-hidden="true">
          <path d="M-10,34 L66.1,31.3" />
          <path d="M66.1,31.3 L735.4,7.6" class="accent" />
          <path d="M735.4,7.6 L810,5" />
          <path d="M70,-6 L46,224" />
          <path d="M734,-6 L758,224" />
          <path d="M-10,118 L56.2,126" />
          <path d="M745.5,104 L810,97" />
        </svg>
        <p class="eyebrow">Sociale softwarestudio</p>
        <h1>Gemeen Goed</h1>
        <p class="tagline"><span>Software voor sociale organisaties.</span> <span>Samen gebouwd, samen gedragen.</span></p>
      </div>
      <div class="intro">
        <p class="lead">Grote softwarebedrijven liggen niet wakker van jouw sector. Wij wel.</p>
        <p>Vandaag betaalt elke organisatie apart voor hetzelfde wiel. De groten laten dure software op maat maken. De rest behelpt zich met pakketten die voor iemand anders gemaakt zijn, of haalt acrobatentoeren uit met Excel.</p>
        <p class="answer">We bouwen software samen met een sector, voor organisaties die er qua software vaak buiten vallen maar wel goeie software verdienen.</p>
        <p class="jump"><a href="#contact">Praat met ons</a></p>
      </div>
    </div>

    <section class="section" aria-labelledby="aanpak">
      <div class="section-head">
        <h2 id="aanpak">Geen software van de plank. Ook geen risicovol maatwerk.</h2>
        <p>We bouwen software die past bij hoe jouw sector werkt, en die gedragen wordt door meerdere organisaties. Zo krijg je de kwaliteit van maatwerk aan een gedeelde prijs.</p>
      </div>
      <ol class="register steps">
        <li class="step">
          <span class="step-n" aria-hidden="true">1</span>
          <div>
            <h3>We brengen de sector aan tafel</h3>
            <p>We beginnen pas als meerdere organisaties met hetzelfde probleem mee aan tafel zitten. Eerst lopen we mee op de werkvloer, tot we snappen waar het gereedschap tegenwerkt.</p>
          </div>
        </li>
        <li class="step">
          <span class="step-n" aria-hidden="true">2</span>
          <div>
            <h3>We bouwen met de eersten</h3>
            <p>Met een paar organisaties maken we een eerste werkende versie. In weken, niet in jaren. Echte gebruikers vanaf dag één.</p>
          </div>
        </li>
        <li class="step">
          <span class="step-n" aria-hidden="true">3</span>
          <div>
            <h3>De sector draagt het</h3>
            <p>Wat werkt, wordt een dienst voor de hele sector. Een gebruikersraad stuurt mee en iedereen betaalt naar draagkracht.</p>
          </div>
        </li>
        <li class="step">
          <span class="step-n" aria-hidden="true">4</span>
          <div>
            <h3>Wij blijven, en je praat met de makers</h3>
            <p>We blijven onderhouden wat we maakten. Heb je een vraag, dan praat je met de mensen die het platform bouwden, en je krijgt snel antwoord. Geen ticket dat weken blijft liggen, geen nieuwe offerte voor elke aanpassing.</p>
          </div>
        </li>
      </ol>
    </section>

    <section class="section" aria-labelledby="werk">
      <div class="section-head">
        <h2 id="werk">Wij bouwden dit al</h2>
        <p>Producten die we van nul opbouwden. Ze draaien vandaag nog altijd.</p>
      </div>
      <ul class="register works">
        <li class="work">
          <span class="work-when">Sinds 2019</span>
          <div>
            <h3><a href="https://opvang.vlaanderen" rel="noopener">Opvang.Vlaanderen</a></h3>
            <p>Alleen de grote steden konden zich een eigen systeem voor kinderopvang veroorloven. Kleine besturen deden het met formuliertjes en Excel. Anton bracht ze samen rond één platform, in een model waar de breedste schouders de grootste last dragen.</p>
            <blockquote>
              <p>Opvang Vlaanderen is van ons, niet van jullie.</p>
              <footer>Uit de gebruikersraad</footer>
            </blockquote>
            <p class="work-fact">200 lokale besturen. Een gebruikersraad beslist mee.</p>
          </div>
        </li>
        <li class="work">
          <span class="work-when">Sinds 2020</span>
          <div>
            <h3><a href="https://hartverwarmers.be" rel="noopener">Hartverwarmers</a></h3>
            <p>Gelanceerd in de eerste dagen van covid voor de woonzorgsector. Uitgegroeid tot een inspiratiebron voor animatoren, met een boek erbij.</p>
            <p class="work-fact">2.200 actieve gebruikers per maand.</p>
          </div>
        </li>
        <li class="work">
          <span class="work-when">Sinds 2009</span>
          <div>
            <h3><a href="https://www.prezly.com" rel="noopener">Prezly</a></h3>
            <p>Communicatiesoftware die Frederik mee oprichtte. Geen sociale sector, wel de plek waar hij leerde een product uit te bouwen dat honderden organisaties elke dag gebruiken.</p>
            <p class="work-fact">Draait vandaag nog.</p>
          </div>
        </li>
        <li class="work">
          <span class="work-when now">Nu in opbouw</span>
          <div>
            <h3>Voor vrijwilligers&shy;coördinatoren</h3>
            <p>Vrijwilligerscoördinatoren verliezen elke maand dagen aan rondklikken in planningssoftware die voor uitzendkantoren gemaakt is. Die tijd hoort naar hun vrijwilligers te gaan. We bouwen een tool waarmee ze hun planning veel sneller rond krijgen.</p>
          </div>
        </li>
      </ul>
    </section>

    <section class="section" aria-labelledby="wie">
      <div class="section-head">
        <h2 id="wie">Wie bouwt hier?</h2>
        <p class="pair">Anton brengt organisaties bijeen, Frederik bouwt de software.</p>
        <p>We doen dit omdat het niet normaal is dat wie het belangrijkste werk doet, de slechtste tools krijgt. Wie de wereld beter maakt, hoort dat niet alleen te doen.</p>
      </div>
      <div class="register" role="group" aria-label="De makers en hun contactgegevens">
        <div class="register-row">
        <div class="plot">
          <div class="plot-head">
            <img class="plot-photo" src="/images/anton.webp" alt="" width="56" height="56" loading="lazy" decoding="async">
            <div>
              <h3 class="plot-name">Anton Aerts</h3>
              <p class="plot-role">Partnerschappen &amp; support</p>
            </div>
          </div>
          <p class="plot-bio">Houdt niet zo van computers, wel van mensen bijeenbrengen. Verenigde 200 lokale besturen rond Opvang.Vlaanderen. Kent de publieke en sociale sector van binnenuit. Is er trots op dat wie een vraag heeft, snel antwoord krijgt.</p>
          <ul class="plot-links">
            <li class="plot-links-mail"><a class="plot-mail" href="mailto:anton@gemeengoed.studio">anton@gemeengoed.studio</a></li>
            <li><a class="plot-secondary" href="https://www.linkedin.com/in/antonaerts/" rel="noopener">LinkedIn<span class="visually-hidden"> van Anton Aerts</span></a></li>
          </ul>
        </div>
        <div class="plot">
          <div class="plot-head">
            <img class="plot-photo" src="/images/frederik.webp" alt="" width="56" height="56" loading="lazy" decoding="async">
            <div>
              <h3 class="plot-name">Frederik Vincx</h3>
              <p class="plot-role">Productontwerp &amp; ontwikkeling</p>
            </div>
          </div>
