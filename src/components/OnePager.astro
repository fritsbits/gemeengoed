---
import '../styles/base.css';

interface Props {
  /* 'met-nico' is the unlisted pitch for a third founder: it shows the track record and Nico's plot.
     Content behind the variant is left out of the public build, not hidden in it. */
  variant?: 'publiek' | 'met-nico';
}

const { variant = 'publiek' } = Astro.props;
const metNico = variant === 'met-nico';
const url = metNico ? 'https://gemeengoed.studio/met-nico' : 'https://gemeengoed.studio/';
const frederikRole = metNico ? 'Productontwerp & co-creatie' : 'Productontwerp & ontwikkeling';

const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Gemeen Goed",
  "url": "https://gemeengoed.studio/",
  "logo": "https://gemeengoed.studio/apple-touch-icon.png",
  "description": "Gemeen Goed is de softwarestudio die organisaties met hetzelfde probleem samenbrengt en de software bouwt die ze samen dragen.",
  "founder": [
    {
      "@type": "Person",
      "name": "Frederik Vincx",
      "jobTitle": frederikRole,
      "image": "https://gemeengoed.studio/images/frederik.webp",
      "email": "frederik@gemeengoed.studio",
      "sameAs": ["https://www.linkedin.com/in/frederikvincx/", "https://frederikvincx.com/"]
    },
    {
      "@type": "Person",
      "name": "Anton Aerts",
      "jobTitle": "Partnerschappen & support",
      "image": "https://gemeengoed.studio/images/anton.webp",
      "email": "anton@gemeengoed.studio",
      "sameAs": "https://www.linkedin.com/in/antonaerts/"
    },
    ...(metNico ? [{
      "@type": "Person",
      "name": "Nico Deblauwe",
      "jobTitle": "Techniek & architectuur",
      "image": "https://gemeengoed.studio/images/nico.webp",
      "email": "nico@gemeengoed.studio",
      "sameAs": ["https://www.linkedin.com/in/nicodeblauwe/", "https://bluepundit.eu/"]
    }] : [])
  ]
};
---

<!DOCTYPE html>
<html lang="nl-BE">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="generator" content={Astro.generator}>
<title>Gemeen Goed - software voor sociale organisaties</title>
<meta name="description" content="Gemeen Goed is de softwarestudio die organisaties met hetzelfde probleem samenbrengt en de software bouwt die ze samen dragen.">
{metNico && <meta name="robots" content="noindex, nofollow">}
<link rel="canonical" href={url}>
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#F1ECDD" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#14170F" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Gemeen Goed">
<meta property="og:locale" content="nl_BE">
<meta property="og:url" content={url}>
<meta property="og:title" content="Gemeen Goed - software voor sociale organisaties">
<meta property="og:description" content="Gemeen Goed is de softwarestudio die organisaties met hetzelfde probleem samenbrengt en de software bouwt die ze samen dragen.">
<meta property="og:image" content="https://gemeengoed.studio/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Gemeen Goed, sociale softwarestudio. Software voor sociale organisaties. Samen gebouwd, samen gedragen.">
<meta name="twitter:card" content="summary_large_image">
<link rel="preload" href="/fonts/lora-600.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/public-sans-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/lora-italic-500.woff2" as="font" type="font/woff2" crossorigin>
<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
<style is:global>
  :root {
    /* Few steps, steep contrast. The three poster sizes also listen to the viewport height,
       so the name, the hook and "Wij wel." share the first screen on a low laptop. */
    --fs-small: 0.875rem;
    --fs-body: 1.0625rem;
    --fs-lede: 1.25rem;
    --fs-h3: 1.5rem;
    --fs-statement: clamp(1.5rem, 2.7vw, 2.25rem);
    --fs-h2: clamp(2rem, 5vw, 4rem);
    --fs-hook: clamp(1.7rem, min(9.4vw, 9.2vh), 5.5rem);
    --fs-name: clamp(2.5rem, min(12.6vw, 15vh), 9rem);
    --fs-punch: clamp(3.5rem, min(17vw, 17.5vh), 10rem);
    --fs-numeral: clamp(3rem, 6vw, 4.5rem);
    --fs-year: clamp(3.5rem, min(11vw, 15vh), 7.5rem);

    --pad: clamp(1.5rem, 5vw, 4rem);
    --gap: clamp(1rem, 2.2vw, 2rem);
    --gutter: clamp(0.625rem, 2vw, 1.75rem);
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    /* One cut for every face on the page: a small parcel, never quite square. */
    --cut-a: polygon(0 3%, 100% 0, 97% 100%, 2.5% 96.5%);
    --cut-b: polygon(2% 0, 100% 2.5%, 98% 97%, 0 100%);
  }

  body {
    font-size: var(--fs-body);
  }

  h1, h2, h3 {
    font-family: var(--font-display);
    font-weight: 600;
    margin: 0;
    text-wrap: balance;
    -webkit-hyphens: manual;
    hyphens: manual;
  }

  p {
    margin: 0;
    text-wrap: pretty;
    overflow-wrap: break-word;
  }

  ul, ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Where hover cannot change the colour, because the link already has the ground's ink,
     the underline does the work. */
  [class*="ground-"] a:hover {
    text-decoration-thickness: 2px;
  }

  .canvas {
    max-width: calc(72rem + 2 * var(--pad));
    margin-inline: auto;
    padding-inline: var(--pad);
  }

  /* A beat is one sheet. It clips, so the lines can run off it on every side. */
  .beat {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    overflow: clip;
    background: var(--bg);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* A surveyed boundary: a hairline that runs off the sheet on both sides, slightly
     off level, with the accent on the stretch that belongs to the content above it.
     One pixel tall, not zero: an empty block lets its margins collapse through it. */
  .boundary {
    position: relative;
    height: 1px;
    rotate: -0.55deg;
    transform-origin: 0 50%;
  }

  .boundary::before,
  .boundary::after {
    content: "";
    position: absolute;
  }

  .boundary::before {
    top: 0;
    left: -100vw;
    right: -100vw;
    height: 1px;
    background: var(--rule-c);
  }

  .boundary::after {
    top: -0.5px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent);
    transform-origin: 0 50%;
  }

  .boundary--plain::after {
    display: none;
  }

  .boundary--falling {
    rotate: 0.45deg;
  }

  /* A boundary stone marks every surveyed corner: a ring in the ground's ink,
     filled with the ground, so the line stops at the post. */
  .stone,
  .step::after {
    position: absolute;
    z-index: 1;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: inset 0 0 0 1.5px var(--fg);
    translate: -50% -50%;
    pointer-events: none;
  }

  /* On a boundary the posts stand where the side boundaries cross it. */
  .boundary .stone {
    top: 0.5px;
    left: calc(-1 * var(--gutter));
  }

  .boundary .stone + .stone {
    left: calc(100% + var(--gutter));
  }

  /* One button for the whole page, squared off like a stamp on a poster.
     Each ground gives it a colourway. */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.5rem;
    padding: 0.375rem 1.5rem;
    border: 1px solid var(--btn-line);
    border-radius: 2px;
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-lede);
    line-height: 1.2;
    text-decoration: none;
  }

  .btn:hover {
    background: var(--btn-bg-hover);
    border-color: var(--btn-line-hover);
    color: var(--btn-fg-hover);
  }

  .btn:active {
    transform: translateY(1px);
  }

  .btn svg {
    flex: none;
    width: 1rem;
    height: 1rem;
  }

  .ground-grove .btn,
  .ground-forest .btn {
    --btn-bg: transparent;
    --btn-fg: var(--on-green);
    --btn-line: var(--on-green);
    --btn-bg-hover: var(--green-accent);
    --btn-fg-hover: var(--on-dawn);
    --btn-line-hover: var(--green-accent);
  }

  .ground-dawn .btn {
    --btn-bg: var(--on-dawn);
    --btn-fg: var(--on-deep);
    --btn-line: var(--on-dawn);
    --btn-bg-hover: var(--on-deep);
    --btn-fg-hover: var(--on-dawn);
    --btn-line-hover: var(--on-dawn);
  }

  /* The face sits in the button's own corner, cut like the portraits further up. */
  .btn--face {
    padding-left: 0.375rem;
  }

  .btn-face {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    object-fit: cover;
    clip-path: var(--cut-a);
  }

  /* ---------- 1. Hero: the nameplate ---------- */

  .hero {
    padding-block: clamp(1.25rem, 3.5vh, 2.75rem) clamp(1.75rem, 4.5vh, 4rem);
  }

  .eyebrow {
    font-size: var(--fs-small);
    letter-spacing: 0.01em;
    color: var(--fg-soft);
    margin-bottom: clamp(0.75rem, 2.5vh, 2.25rem);
  }

  /* As wide as the name, so the ochre boundary measures exactly the wordmark. */
  .nameplate {
    position: relative;
    width: fit-content;
    max-width: 100%;
  }

  /* The side boundaries run off the top of the sheet and down to its lower edge. */
  .nameplate::before,
  .nameplate::after {
    content: "";
    position: absolute;
    top: -40rem;
    bottom: -40rem;
    width: 1px;
    background: var(--rule-c);
    pointer-events: none;
  }

  .nameplate::before {
    left: calc(-1 * var(--gutter));
    rotate: 1.1deg;
  }

  .nameplate::after {
    right: calc(-1 * var(--gutter));
    rotate: -1.1deg;
  }

  h1 {
    font-size: var(--fs-name);
    line-height: 0.95;
    letter-spacing: -0.025em;
    white-space: nowrap;
  }

  .hero .boundary {
    margin-block: clamp(0.75rem, min(2.6vw, 2.4vh), 2.25rem) clamp(0.75rem, min(2.2vw, 2vh), 1.75rem);
  }

  /* No width of its own, so a long tagline never stretches the nameplate past the name. */
  .tagline {
    width: 0;
    min-width: 100%;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.25rem, min(2.7vw, 3.6vh), 2.25rem);
    line-height: 1.2;
    color: var(--moss-deep);
    text-wrap: balance;
  }

  /* Each sentence of the tagline keeps its own line where the width allows it. */
  .tagline span {
    display: block;
  }

  /* ---------- 2. Opening: the night sheet ---------- */

  .opening {
    min-height: min(100svh, 62rem);
    display: flex;
    flex-direction: column;
    padding-block: clamp(2rem, 5vh, 4.25rem) clamp(3.5rem, 9vh, 6rem);
    border-block: 1px solid var(--grove-edge);
  }

  .opening > .canvas {
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(3rem, 8vh, 5rem);
  }

  .hook {
    font-size: var(--fs-hook);
    line-height: 1.02;
    letter-spacing: -0.025em;
    overflow-wrap: break-word;
  }

  /* The peak of the page: nothing else is set this large. */
  .hook .punch {
    display: block;
    margin-top: 0.12em;
    font-style: italic;
    font-weight: 500;
    font-size: var(--fs-punch);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--accent);
  }

  .opening-body .boundary {
    margin-bottom: clamp(2rem, 5vh, 3rem);
  }

  .opening-body .problem {
    color: var(--fg-soft);
    max-width: 34rem;
  }

  .opening-body .answer {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-statement);
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin-top: 2rem;
    text-wrap: balance;
  }

  .jump {
    margin-top: 2rem;
  }

  /* ---------- 3. Aanpak: a sage plot laid on the paper ---------- */

  /* The plot is wider than the text column. From desktop up the paper shows around it;
     its text keeps the page's left edge whatever the margin. */
  .aanpak {
    --plot-m: 0px;
    padding-block: var(--plot-m) clamp(3.5rem, 9vh, 6.5rem);
  }

  .aanpak-ground {
    position: relative;
    overflow: hidden;
    overflow: clip;
    width: calc(100% - 2 * var(--plot-m));
    max-width: 84rem;
    margin-inline: auto;
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    background: var(--bg);
  }

  .aanpak-ground > .canvas {
    max-width: calc(72rem + 2 * (var(--pad) - var(--plot-m)));
    padding-inline: calc(var(--pad) - var(--plot-m));
  }

  .aanpak-grid {
    display: grid;
    gap: 2.75rem clamp(2.5rem, 6vw, 6rem);
  }

  .aanpak h2 {
    font-size: clamp(2rem, 3.8vw, 3.25rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
  }

  .aanpak h2 span {
    display: block;
  }

  .aanpak h2 .turn {
    color: var(--moss);
  }

  .aanpak .lede {
    margin-top: clamp(1.25rem, 2.4vw, 2rem);
    font-size: var(--fs-lede);
    line-height: 1.5;
    color: var(--fg-soft);
    max-width: 30rem;
  }

  .steps {
    position: relative;
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: clamp(3.5rem, 7vw, 5.5rem) minmax(0, 1fr);
    padding-block: clamp(1.5rem, 2.8vw, 2.25rem) clamp(1.75rem, 3vw, 2.5rem);
  }

  .step:last-child {
    padding-bottom: 0;
  }

  /* Row boundaries overshoot the text block, like lines ruled past the corner of a plot.
     Each one turns on its own post, so the post stays on the line. */
  .step::before {
    content: "";
    position: absolute;
    top: 0;
    left: calc(-1 * var(--gutter));
    right: calc(-1 * var(--gutter));
    height: 1px;
    background: var(--rule-c);
    transform-origin: var(--gutter) 50%;
  }

  .step:nth-child(odd)::before { rotate: -0.18deg; }
  .step:nth-child(even)::before { rotate: 0.14deg; }

  .step::after {
    content: "";
    top: 0.5px;
    left: 0;
  }

  /* The order is the message, so the numerals are figures, not bullets. */
  .step-n,
  .when-year,
  .fig {
    font-family: var(--font-display);
    font-weight: 600;
    font-variant-numeric: lining-nums;
  }

  .step-n {
    font-size: var(--fs-numeral);
    line-height: 0.8;
    letter-spacing: -0.03em;
    color: var(--accent);
  }

  .step h3 {
    font-size: var(--fs-h3);
    line-height: 1.2;
    letter-spacing: -0.005em;
  }

  .step p {
    margin-top: 0.5rem;
    color: var(--fg-soft);
    max-width: 36rem;
  }

  /* ---------- 4. Werk: the proof, ranked ---------- */

  .werk {
    padding-block: clamp(4.5rem, 12vh, 8rem);
  }

  .werk h2,
  .wie h2 {
    font-size: var(--fs-h2);
    line-height: 1.04;
    letter-spacing: -0.02em;
  }

  .werk .lede {
    margin-top: 1rem;
    font-size: var(--fs-lede);
    line-height: 1.5;
    color: var(--fg-soft);
    max-width: 26rem;
  }

  .werk .boundary {
    margin-block: clamp(2rem, 4vw, 3rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .when {
    font-size: var(--fs-small);
    letter-spacing: 0.01em;
    color: var(--fg-soft);
  }

  .when-word,
  .when-year {
    display: block;
  }

  .when-year {
    letter-spacing: -0.035em;
    line-height: 0.9;
    color: var(--accent);
  }

  .work h3 {
    font-size: var(--fs-h3);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  /* A taller hit area for the product links without moving the heading. */
  .work h3 a {
    display: inline-block;
    padding-block: 0.4rem;
    margin-block: -0.4rem;
  }

  .work-text {
    margin-top: 0.75rem;
    color: var(--fg-soft);
    max-width: 38rem;
  }

  /* Figures read as figures: the number takes the display size, the sentence follows it. */
  .fact {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-lede);
    line-height: 1.3;
    color: var(--fg);
  }

  .fig {
    letter-spacing: -0.03em;
    line-height: 0.9;
  }

  .fact-text {
    flex: 1 1 12rem;
  }

  .work--flagship .when-year { font-size: var(--fs-year); }
  .work--flagship h3 { font-size: clamp(1.625rem, 7vw, 2.75rem); }
  .work--flagship .fig { font-size: clamp(3.25rem, 7vw, 5.5rem); }
  .work--flagship .when { margin-bottom: 1.25rem; }

  .work--mid .when-year { font-size: clamp(3rem, 6vw, 4.5rem); }
  .work--mid h3 { font-size: clamp(1.5rem, 3vw, 2rem); }
  .work--mid .fig { font-size: clamp(2.25rem, 4vw, 3.25rem); }
  .work--mid .when { margin-bottom: 1rem; }

  .work--background .when-year { font-size: 2.25rem; }
  .work--background .when { margin-bottom: 0.75rem; }
  .work--background .fact { font-size: var(--fs-body); margin-top: 0.875rem; }

  /* The user council's sentence gets a ground of its own, across the whole sheet. */
  .quote {
    position: relative;
    margin: clamp(3rem, 7vw, 5rem) 0 0;
    padding-block: clamp(3rem, 8vw, 6rem);
    background: var(--band);
    color: var(--on-deep);
  }

  .quote::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset-block: 0;
    left: 50%;
    width: 100vw;
    translate: -50% 0;
    background: var(--band);
  }

  .quote ::selection {
    background: var(--on-deep);
    color: var(--band);
  }

  .quote p {
    quotes: '\201C' '\201D';
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.875rem, 5.6vw, 4.75rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .quote .q-open {
    position: relative;
  }

  /* The opening mark hangs in the margin so the words keep the left edge. */
  .quote .q-open::before {
    content: open-quote;
    position: absolute;
    right: 100%;
    margin-right: 0.04em;
  }

  .quote .q-close::after {
    content: close-quote;
  }

  /* Two sentences: where they wrap, each takes its own line. */
  .quote footer {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    margin-top: clamp(1.25rem, 3vw, 2rem);
    font-size: var(--fs-body);
    text-wrap: balance;
  }

  /* The rule sits on the middle of the first line, however many lines follow. */
  .quote footer::before {
    content: "";
    flex: none;
    width: 2.5rem;
    height: 1px;
    margin-top: 0.8em;
    background: currentColor;
  }

  .works > .work + .work {
    margin-top: clamp(3rem, 7vw, 4.5rem);
  }

  /* Not built yet, so its boundary is pegged out, not drawn. */
  .work--next {
    position: relative;
    isolation: isolate;
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .work--next .parcels {
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .work--next .parcels path {
    stroke: var(--moss);
    stroke-width: 1.25;
    stroke-dasharray: 7 6;
  }

  .work--next .when {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.625rem, 3.2vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--moss);
    margin-bottom: 1rem;
  }

  .work--next h3 {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  /* ---------- 5. Wie: a drawn plan of two adjoining plots ---------- */

  .wie {
    padding-block: clamp(5rem, 14vh, 9rem) clamp(5rem, 13vh, 8.5rem);
  }

  /* The conviction is set large, next to the question it answers. */
  .why {
    margin-top: 1.75rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-statement);
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .why .also {
    display: block;
    margin-top: 0.6em;
    font-style: italic;
    font-weight: 500;
    font-size: var(--fs-h3);
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--moss);
  }

  .pair {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    line-height: 1.25;
    color: var(--moss);
  }

  /* Stacked plots share rows of equal height, so the shared boundary sits on the halfway line. */
  .plan {
    position: relative;
    isolation: isolate;
    margin-top: 1.5rem;
    display: grid;
    grid-auto-rows: 1fr;
  }

  .plan .parcels {
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .plan-drawing--wide { display: none; }

  .plan .parcels .plot-a { fill: var(--sheet); }
  .plan .parcels .plot-b { fill: var(--sage); }

  .plan .parcels path {
    stroke: var(--rule-c);
  }

  .plan .parcels path.shared {
    stroke: var(--accent);
    stroke-width: 2;
  }

  .plan > .stone {
    left: var(--x);
    top: var(--y);
  }

  .plan > .stone:nth-of-type(1) { --x: 0%;    --y: 0.6%; }
  .plan > .stone:nth-of-type(2) { --x: 100%;  --y: 0%; }
  .plan > .stone:nth-of-type(3) { --x: 99%;   --y: 100%; }
  .plan > .stone:nth-of-type(4) { --x: 1.2%;  --y: 99.4%; }
  .plan > .stone:nth-of-type(5) { --x: 0.6%;  --y: 49.7%; }
  .plan > .stone:nth-of-type(6) { --x: 99.5%; --y: 50.5%; }

  /* Three plots: the middle one keeps the sage, the outer two share the sheet. */
  .plan .parcels .plot-c { fill: var(--sheet); }

  .plan--three > .stone:nth-of-type(1) { --x: 0%;     --y: 0.6%; }
  .plan--three > .stone:nth-of-type(2) { --x: 100%;   --y: 0%; }
  .plan--three > .stone:nth-of-type(3) { --x: 99%;    --y: 100%; }
  .plan--three > .stone:nth-of-type(4) { --x: 1.2%;   --y: 99.4%; }
  .plan--three > .stone:nth-of-type(5) { --x: 0.39%;  --y: 33%; }
  .plan--three > .stone:nth-of-type(6) { --x: 99.66%; --y: 33.8%; }
  .plan--three > .stone:nth-of-type(7) { --x: 0.81%;  --y: 67%; }
  .plan--three > .stone:nth-of-type(8) { --x: 99.34%; --y: 66.2%; }

  .plan--three .plot:last-of-type .plot-photo {
    clip-path: var(--cut-a);
  }

  /* A column, so the mail and links sit on one line across both plots whatever the bio length. */
  .plot {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: clamp(1.75rem, 3.4vw, 3rem) clamp(1.25rem, 3.4vw, 3rem) clamp(1.25rem, 2.6vw, 2.25rem);
  }

  .plot-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: end;
    gap: clamp(1rem, 2.2vw, 1.75rem);
    margin-bottom: 1.5rem;
  }

  .plot-photo {
    display: block;
    width: clamp(6.5rem, 16vw, 12.5rem);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    background: var(--paper-alt);
    clip-path: var(--cut-a);
  }

  .plot + .plot .plot-photo {
    clip-path: var(--cut-b);
  }

  .plot-name {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .plot-role {
    margin-top: 0.375rem;
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--fg-soft);
  }

  .plot-bio {
    color: var(--fg-soft);
    max-width: 32rem;
    margin-bottom: 1rem;
  }

  /* The mail takes its own row, the secondary links share the row below it. */
  .plot-links {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 1.25rem;
  }

  .plot-links-mail {
    flex: 0 0 100%;
  }

  /* The padding makes the tap target, the list itself has no gap. */
  .plot-mail,
  .plot-secondary {
    display: inline-block;
    padding-block: 0.55rem;
  }

  /* Under keyboard focus the tap padding becomes margin, so the ring hugs the text
     like on every other link and nothing moves. */
  .plot-mail:focus-visible,
  .plot-secondary:focus-visible {
    padding-block: 0;
    margin-block: 0.55rem;
  }

  .plot-mail {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    overflow-wrap: anywhere;
  }

  .plot-secondary {
    font-size: var(--fs-small);
    color: var(--fg-soft);
  }

  /* ---------- 6. The ask: the morning sheet ---------- */

  /* The page ends on the ask. The jump lands with the sheet's own edge at the top. */
  .cta {
    padding-block: clamp(5rem, 15vh, 10rem) clamp(3.5rem, 8vh, 5.5rem);
    scroll-margin-top: 0;
    text-align: center;
  }

  .invite {
    position: relative;
    max-width: 58rem;
    margin-inline: auto;
  }

  /* The nameplate, turned over: the side boundaries come in from the top
     and stop just past the closing line, where the posts stand. */
  .invite::before,
  .invite::after {
    content: "";
    position: absolute;
    top: -40rem;
    bottom: -2.25rem;
    width: 1px;
    background: var(--rule-c);
    transform-origin: 50% 100%;
    pointer-events: none;
  }

  .invite::before {
    left: calc(-1 * var(--gutter));
    rotate: -0.8deg;
  }

  .invite::after {
    right: calc(-1 * var(--gutter));
    rotate: 0.8deg;
  }

  .cta h2 {
    font-size: clamp(2.25rem, 6vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    padding-inline: clamp(0.5rem, 3vw, 2rem);
  }

  .cta-say {
    max-width: 34rem;
    margin: clamp(1.25rem, 2.6vw, 2rem) auto 0;
    padding-inline: clamp(0.5rem, 3vw, 2rem);
    font-size: var(--fs-lede);
    line-height: 1.5;
    text-wrap: balance;
  }

  .cta .btn {
    margin-top: 2.25rem;
  }

  .cta-address {
    margin-top: 0.875rem;
    overflow-wrap: anywhere;
    -webkit-user-select: all;
    user-select: all;
  }

  .cta .boundary {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  /* The footer stays on the morning sheet, so the page ends in one ground. */
  .colophon {
    background: var(--bg);
    padding-block: 0.5rem 2rem;
    text-align: center;
    font-size: var(--fs-small);
    letter-spacing: 0.01em;
  }

  /* ---------- From tablet up ---------- */

  @media (min-width: 52rem) {
    /* The sentence straddles the shared boundary: Anton's half above his plot, Frederik's above his. */
    .pair:not(.pair--three) {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 clamp(1.5rem, 3vw, 2.5rem);
    }

    .pair:not(.pair--three) span:first-child {
      text-align: right;
    }

    .plan:not(.plan--three) {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: auto;
    }

    .plan:not(.plan--three) .plan-drawing--tall { display: none; }
    .plan:not(.plan--three) .plan-drawing--wide { display: block; }

    .plan:not(.plan--three) > .stone:nth-of-type(1) { --x: 0%;    --y: 1.8%; }
    .plan:not(.plan--three) > .stone:nth-of-type(2) { --x: 100%;  --y: 0%; }
    .plan:not(.plan--three) > .stone:nth-of-type(3) { --x: 99.4%; --y: 100%; }
    .plan:not(.plan--three) > .stone:nth-of-type(4) { --x: 0.8%;  --y: 98.5%; }
    .plan:not(.plan--three) > .stone:nth-of-type(5) { --x: 49.2%; --y: 0.9%; }
    .plan:not(.plan--three) > .stone:nth-of-type(6) { --x: 50.8%; --y: 99.25%; }
  }

  /* Three plots only stand side by side once each can hold a bio. Below this they stack. */
  @media (min-width: 64rem) {
    .pair--three {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    /* Each clause sits over its own plot, on the line where the plot's text starts. */
    .pair--three span {
      padding-inline: clamp(1.25rem, 2.4vw, 2.25rem);
    }

    .plan--three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-rows: auto;
    }

    .plan--three .plan-drawing--tall { display: none; }
    .plan--three .plan-drawing--wide { display: block; }

    .plan--three .plot {
      padding-inline: clamp(1.25rem, 2.4vw, 2.25rem);
    }

    /* The photo stands above the name, so the name keeps the plot's full width. */
    .plan--three .plot-head {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }

    .plan--three .plot-photo {
      width: clamp(7.5rem, 11vw, 10rem);
    }

    .plan--three > .stone:nth-of-type(1) { --x: 0%;    --y: 1.8%; }
    .plan--three > .stone:nth-of-type(2) { --x: 100%;  --y: 0%; }
    .plan--three > .stone:nth-of-type(3) { --x: 99.4%; --y: 100%; }
    .plan--three > .stone:nth-of-type(4) { --x: 0.8%;  --y: 98.5%; }
    .plan--three > .stone:nth-of-type(5) { --x: 32.8%; --y: 1.21%; }
    .plan--three > .stone:nth-of-type(6) { --x: 33.8%; --y: 99%; }
    .plan--three > .stone:nth-of-type(7) { --x: 67.2%; --y: 0.59%; }
    .plan--three > .stone:nth-of-type(8) { --x: 66.2%; --y: 99.5%; }
  }

  /* ---------- The twelve-column sheet ---------- */

  @media (min-width: 56rem) {
    .grid {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
    }

    .opening-body .problem {
      grid-column: 1 / span 5;
    }

    .opening-body .reply {
      grid-column: 7 / -1;
    }

    .opening-body .answer {
      margin-top: 0;
    }

    .werk-head h2 {
      grid-column: 1 / span 7;
    }

    .werk-head .lede {
      grid-column: 8 / -1;
      align-self: end;
      margin-top: 0;
      padding-bottom: 0.5rem;
    }

    .works > .work {
      grid-column: 1 / -1;
    }

    /* Each ranked entry repeats the sheet's own columns, so its parts land on them. */
    .work--flagship,
    .works > .work--next {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gap);
    }

    .work--flagship .when {
      grid-column: 1 / span 4;
    }

    .work--flagship .work-main {
      grid-column: 5 / -1;
      padding-top: 0.75rem;
    }

    .work--flagship .quote {
      grid-column: 1 / -1;
    }

    .works > .work--mid {
      grid-column: 1 / span 7;
      display: grid;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      column-gap: var(--gap);
    }

    .work--mid .when {
      grid-column: 1 / span 3;
    }

    .work--mid .work-main {
      grid-column: 4 / -1;
      padding-top: 0.5rem;
    }

    .works > .work--background {
      grid-column: 9 / -1;
    }

    .work--next .when {
      grid-column: 1 / span 4;
      margin-bottom: 0;
    }

    .work--next .work-main {
      grid-column: 5 / -1;
    }

    /* The conviction starts on the halfway line, above the boundary the two plots share. */
    .wie-head h2 {
      grid-column: 1 / span 6;
    }

    .wie-head .why {
      grid-column: 7 / -1;
      margin-top: 0.35rem;
    }

    .cta h2 span {
      display: block;
    }
  }

  @media (min-width: 60rem) {
    .aanpak {
      --plot-m: calc(var(--pad) * 0.4);
    }

    .aanpak-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }

    /* The figures step clear of the boundary that runs through the posts. */
    .step {
      padding-left: clamp(1rem, 1.8vw, 1.75rem);
    }

    /* One boundary runs through all four posts and off the plot at both ends. */
    .steps::before {
      content: "";
      position: absolute;
      top: -12rem;
      bottom: -12rem;
      left: 0;
      width: 1px;
      background: var(--rule-c);
      rotate: 0.12deg;
    }
  }

  /* Only where the whole heading fits the screen with room to spare. */
  @media (min-width: 60rem) and (min-height: 44rem) {
    .aanpak-head {
      position: sticky;
      top: 3rem;
    }
  }

  /* Wide enough for the hook and the quote to hold their lines. */
  @media (min-width: 80rem) {
    .hook span,
    .quote p span {
      display: block;
    }

    .quote {
      padding-inline: calc((100% - 11 * var(--gap)) / 12 + var(--gap)) 0;
    }
  }

  @media print {
    .beat,
    .aanpak-ground,
    .colophon,
    .quote,
    .quote::before {
      background: #fff;
      color: #000;
    }

    .ground-grove,
    .ground-forest {
      --accent: #000;
    }

    .boundary,
    .stone,
    .plan .parcels,
    .nameplate::before,
    .nameplate::after,
    .invite::before,
    .invite::after,
    .step::before,
    .step::after,
    .steps::before {
      display: none;
    }

    .opening {
      min-height: 0;
    }

    .aanpak-head {
      position: static;
    }

    .btn,
    .btn:hover {
      background: none;
      border-color: #000;
      color: #000;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }

    .btn {
      transition: color 0.15s ease-out, background-color 0.15s ease-out, border-color 0.15s ease-out, transform 0.1s ease-out;
    }

    /* The one authored moment: the boundary under the name is set out, post to post.
       The sheet, the name and the hairline are there from the first frame. */
    .hero .boundary::after {
      animation: survey 1.3s var(--ease-out) 0.3s both;
    }
  }

  @keyframes survey {
    from { scale: 0 1; }
    to { scale: 1 1; }
  }
</style>
</head>
<body>
  <main>

    <header class="beat hero ground-sage">
      <div class="canvas">
        <p class="eyebrow">Sociale softwarestudio</p>
        <div class="nameplate">
          <h1>Gemeen Goed</h1>
          <div class="boundary" aria-hidden="true"><span class="stone"></span><span class="stone"></span></div>
          <p class="tagline"><span>Software voor sociale organisaties.</span> <span>Samen gebouwd, samen gedragen.</span></p>
        </div>
      </div>
    </header>

    <section class="beat opening ground-grove" aria-labelledby="haak">
      <div class="canvas">
        <h2 class="hook" id="haak"><span>Grote softwarebedrijven</span> <span>liggen niet wakker</span> <span>van jouw sector.</span> <span class="punch">Wij wel.</span></h2>
        <div class="opening-body">
          <div class="boundary boundary--plain boundary--falling" aria-hidden="true"></div>
          <div class="grid">
            <p class="problem">Vandaag betaalt elke organisatie apart voor hetzelfde wiel. De groten laten dure software op maat maken. De rest behelpt zich met pakketten die voor iemand anders gemaakt zijn, of haalt acrobatentoeren uit met Excel.</p>
            <div class="reply">
              <p class="answer">Goeie software hoort gemeengoed te zijn. Dus bouwen we ze samen met een hele sector, voor organisaties die anders uit de boot vallen.</p>
              <p class="jump">
                <a class="btn" href="#contact">Praat met ons
                  <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 2v11M3.5 8.5 8 13l4.5-4.5"/></svg>
                </a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="beat aanpak ground-paper" aria-labelledby="aanpak">
      <div class="aanpak-ground ground-sage">
        <div class="canvas aanpak-grid">
          <div class="aanpak-head">
            <h2 id="aanpak"><span>Geen software van de plank.</span> <span class="turn">Ook geen risicovol maatwerk.</span></h2>
            <p class="lede">We bouwen software die past bij hoe jouw sector werkt, en die gedragen wordt door meerdere organisaties. Zo krijg je de kwaliteit van maatwerk aan een gedeelde prijs.</p>
          </div>
          <ol class="steps">
            <li class="step">
              <span class="step-n" aria-hidden="true">1</span>
              <div>
                <h3>We brengen de sector aan tafel</h3>
                <p>We beginnen pas als meerdere organisaties met hetzelfde probleem mee aan tafel zitten. Eerst lopen we mee op de werkvloer, tot we snappen waar het gereedschap tegenwerkt.</p>
              </div>
            </li>
            <li class="step">
              <span class="step-n" aria-hidden="true">2</span>
              <div>
                <h3>We bouwen met de eersten</h3>
                <p>Met een paar organisaties maken we een eerste werkende versie. In weken, niet in jaren. Echte gebruikers vanaf dag één.</p>
              </div>
            </li>
            <li class="step">
              <span class="step-n" aria-hidden="true">3</span>
              <div>
                <h3>De sector draagt het</h3>
                <p>Wat werkt, wordt gemeengoed: een dienst voor de hele sector. Een gebruikersraad stuurt mee en iedereen betaalt naar draagkracht.</p>
              </div>
            </li>
            <li class="step">
              <span class="step-n" aria-hidden="true">4</span>
              <div>
                <h3>Wij blijven, en je praat met de makers</h3>
                <p>We blijven onderhouden wat we maakten. Heb je een vraag, dan praat je met de mensen die het platform bouwden, en je krijgt snel antwoord. Geen ticket dat weken blijft liggen, geen nieuwe offerte voor elke aanpassing.</p>
              </div>
            </li>
          </ol>
        </div>
      </div>
    </section>

    {/* Publiek verborgen tot 1 november: Anton zit nog onder een non-compete. Daarna mag dit blok voor iedereen. */}
    {metNico && (
    <section class="beat werk ground-alt" aria-labelledby="werk">
